{
  "name": "@cyrene/desktop",
  "version": "0.1.0",
  "description": "Cyrene 桌面客户端(Electron + Vue 3 + TypeScript + electron-vite)",
  "main": "./out/main/index.js",
  "author": "Cyrene",
  "private": true,
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings=0",
    "pretest": "node scripts/check-node-version.mjs",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "pnpm ensure:electron && electron-vite build --mode test && vitest run --config vitest.integration.config.mts",
    "preintegration:stage-h": "node scripts/check-node-version.mjs && electron-vite build --mode test",
    "integration:stage-h": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/integration/stage-h/runner.ts",
    "test:stage-h-runner": "vitest run --config vitest.config.mts tests/unit/stage-h-runner.spec.ts",
    "ensure:electron": "node -e \"require('electron')\"",
    "test:e2e": "echo 'E2E(Playwright) 留待阶段 3 配置——本命令未实现，非零退出防假绿' && exit 1",
    "make": "echo 'Forge 打包留待阶段 8 配置——本命令未实现，非零退出防假绿' && exit 1",
    "package": "electron-vite build && electron-builder --dir",
    "verify:artifact": "node scripts/verify-artifact.cjs",
    "verify:sensitive": "node scripts/verify-sensitive.mjs",
    "check:contract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-backend-contract.mjs",
    "live2d:install": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/live2d-install.mjs",
    "check:node": "node scripts/check-node-version.mjs"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "3.4.14",
    "marked": "^18.0.9",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/fuses": "2.1.3",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.11",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "semver": "^7.8.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.0"
  }
}
