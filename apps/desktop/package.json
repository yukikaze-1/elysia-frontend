{
  "name": "@cyrene/desktop",
  "version": "0.1.0",
  "description": "Cyrene 桌面客户端(Electron + Vue 3 + TypeScript + electron-vite)",
  "main": "./out/main/index.js",
  "author": "Cyrene",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "pnpm ensure:electron && electron-vite build --mode test && vitest run --config vitest.integration.config.mts",
    "ensure:electron": "node node_modules/electron/install.js",
    "test:e2e": "echo 'E2E(Playwright) 留待阶段 3 配置' && exit 0",
    "make": "echo 'Forge 打包留待阶段 8 配置' && exit 0",
    "package": "electron-vite build && electron-builder --dir",
    "verify:artifact": "node scripts/verify-artifact.cjs"
  },
  "dependencies": {
    "marked": "^18.0.9",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.0"
  }
}
