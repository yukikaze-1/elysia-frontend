{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    // P1-11（2026-09-11）：同 node 侧——基座 `@electron-toolkit/tsconfig` 显式关了 noImplicitAny。
    // web 侧开启后实测**零新增错误**（渲染层本就没有隐式 any），故属"零成本防线"：
    // 只在将来有人引入隐式 any 时才会红。
    "noImplicitAny": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "exclude": [
    // 阶段 5 批次 A（Task 1）Important B：vendored Cubism Web Framework 源码（59 ts，第三方）
    // 不参与 strict vue-tsc 程序（include 已含 src/renderer/src/**，否则必挂）；类型经
    // live2d/framework.d.ts ambient 桩提供。live2d/core/live2dcubismcore.d.ts 不在排除目录，
    // 仍经 include 自动纳入以提供全局 Live2DCubismCore namespace（C2）。
    "src/renderer/src/live2d/framework"
  ]
}
